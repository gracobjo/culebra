{
  "name": "@culebra/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../../.env ../../node_modules/next/dist/bin/next dev",
    "build": "npm run build --workspace @culebra/domain && npm run build --workspace @culebra/auth && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@culebra/auth": "*",
    "@culebra/db": "*",
    "next": "^15.5.23",
    "next-auth": "^5.0.0-beta.29",
    "pdfkit": "^0.19.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
