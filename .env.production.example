NODE_ENV=production

# PostgreSQL (docker-compose.prod.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[REEMPLAZAR_PASSWORD_FUERTE]
POSTGRES_DB=culebra

# Puertos expuestos en el host
WEB_PORT=3000
API_PORT=4000

# Database (sobreescrita en compose para red interna)
DATABASE_URL=postgresql://postgres:[REEMPLAZAR_PASSWORD_FUERTE]@postgres:5432/culebra

# Auth
AUTH_SECRET=[REEMPLAZAR_SECRETO_LARGO_ALEATORIO]
AUTH_URL=https://tu-dominio.com
NEXT_PUBLIC_APP_URL=https://tu-dominio.com
SESSION_COOKIE_NAME=culebra_session
CART_COOKIE_NAME=culebra_cart
SESSION_MAX_AGE_DAYS=7
CORS_ORIGIN=https://tu-dominio.com

# API / proxy
NEXT_PUBLIC_API_URL=https://api.tu-dominio.com
TRUST_PROXY=true
RUN_MIGRATIONS=true
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CART_MAX=40
RATE_LIMIT_ADMIN_MAX=60

# Payments
STRIPE_SECRET_KEY=[REEMPLAZAR_EN_PRODUCCION]
STRIPE_WEBHOOK_SECRET=[REEMPLAZAR_EN_PRODUCCION]
STRIPE_PUBLISHABLE_KEY=[REEMPLAZAR_EN_PRODUCCION]

# Storage
S3_ENDPOINT=[REEMPLAZAR_EN_PRODUCCION]
S3_REGION=eu-west-1
S3_BUCKET=culebra-assets
S3_ACCESS_KEY=[REEMPLAZAR_EN_PRODUCCION]
S3_SECRET_KEY=[REEMPLAZAR_EN_PRODUCCION]

# Email
EMAIL_FROM=no-reply@tu-dominio.com
EMAIL_PROVIDER_API_KEY=[REEMPLAZAR_EN_PRODUCCION]

# No usar seed de admin en produccion salvo bootstrap inicial controlado
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
