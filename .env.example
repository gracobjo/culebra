NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/culebra

# Auth
AUTH_SECRET=[REEMPLAZAR_EN_LOCAL]
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=culebra_session
CART_COOKIE_NAME=culebra_cart
SESSION_MAX_AGE_DAYS=7
CORS_ORIGIN=http://localhost:3000

# Seed opcional (solo desarrollo)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Payments
STRIPE_SECRET_KEY=[REEMPLAZAR_EN_LOCAL]
STRIPE_WEBHOOK_SECRET=[REEMPLAZAR_EN_LOCAL]
STRIPE_PUBLISHABLE_KEY=[REEMPLAZAR_EN_LOCAL]
# Webhook local: http://localhost:3000/api/stripe/webhook
# o http://localhost:4000/webhooks/stripe

# Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=culebra-assets
S3_ACCESS_KEY=[REEMPLAZAR_EN_LOCAL]
S3_SECRET_KEY=[REEMPLAZAR_EN_LOCAL]

# Email
EMAIL_FROM=no-reply@example.com
EMAIL_PROVIDER_API_KEY=[REEMPLAZAR_EN_LOCAL]

# API
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
TRUST_PROXY=false
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CART_MAX=40
RATE_LIMIT_ADMIN_MAX=60
