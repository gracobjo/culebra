NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/culebra

# Auth
AUTH_SECRET=[REEMPLAZAR_EN_LOCAL]
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En GitHub Codespaces, usa la URL pública del puerto 3000, p. ej.:
# AUTH_URL=https://TU-CODESPACE-3000.app.github.dev
# NEXT_PUBLIC_APP_URL=https://TU-CODESPACE-3000.app.github.dev
# Orígenes extra para Server Actions (host sin https, separados por coma)
# SERVER_ACTIONS_ALLOWED_ORIGINS=mi-codespace-3000.app.github.dev,localhost:3000
# Alinear x-forwarded-host con origin en dev/Codespaces (por defecto activo fuera de prod)
# ALIGN_FORWARDED_HOST=true
SESSION_COOKIE_NAME=culebra_session
CART_COOKIE_NAME=culebra_cart
SESSION_MAX_AGE_DAYS=7
CORS_ORIGIN=http://localhost:3000

# Seed opcional (solo desarrollo)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Payments
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR
STRIPE_PUBLISHABLE_KEY=pk_test_REEMPLAZAR
# Webhook local: http://localhost:3000/api/stripe/webhook
# o http://localhost:4000/webhooks/stripe

# Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=culebra-assets
S3_ACCESS_KEY=[REEMPLAZAR_EN_LOCAL]
S3_SECRET_KEY=[REEMPLAZAR_EN_LOCAL]

# Email
EMAIL_FROM=no-reply@example.com
EMAIL_PROVIDER_API_KEY=[REEMPLAZAR_EN_LOCAL]

# Cron
CRON_SECRET=[REEMPLAZAR_EN_LOCAL]

# Telegram — Notificaciones SLA (desarrollo)
# Obtener BOT_TOKEN en @BotFather → /newbot
# Obtener TELEGRAM_CHAT_ID enviando un mensaje al bot y consultando:
#   https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Assistant (chat FAQ + búsqueda de productos)
ENABLE_ASSISTANT=true
NEXT_PUBLIC_ENABLE_ASSISTANT=true
# OpenAI en la nube (opcional)
OPENAI_API_KEY=
# LM Studio / API compatible OpenAI (local)
ASSISTANT_API_BASE_URL=http://localhost:1234/v1
ASSISTANT_API_KEY=lm-studio
ASSISTANT_MODEL=qwen2.5-3b-instruct
# false recomendado para modelos pequeños locales (Qwen 3B); true para GPT con tools
ASSISTANT_USE_TOOLS=false
ASSISTANT_RATE_LIMIT_MAX=30

# Marketplace (PDF / documentos)
MARKETPLACE_NAME=Sabores de la Culebra
MARKETPLACE_LEGAL_NAME=
MARKETPLACE_TAX_ID=
MARKETPLACE_EMAIL=
MARKETPLACE_ADDRESS=

# API
API_PORT=4000
ENABLE_SWAGGER=true
NEXT_PUBLIC_API_URL=http://localhost:4000
TRUST_PROXY=false
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CART_MAX=40
RATE_LIMIT_ADMIN_MAX=60
