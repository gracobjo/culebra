{
  "name": "@culebra/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./affiliate.constants": {
      "types": "./src/affiliate.constants.ts",
      "import": "./src/affiliate.constants.ts",
      "default": "./src/affiliate.constants.ts"
    },
    "./showroom-footfall.schemas": {
      "types": "./src/showroom-footfall.schemas.ts",
      "import": "./src/showroom-footfall.schemas.ts",
      "default": "./src/showroom-footfall.schemas.ts"
    },
    "./showroom-loyalty.schemas": {
      "types": "./src/showroom-loyalty.schemas.ts",
      "import": "./src/showroom-loyalty.schemas.ts",
      "default": "./src/showroom-loyalty.schemas.ts"
    }
  },
  "scripts": {
    "build": "npm run build --workspace @culebra/domain && tsc --project tsconfig.json --noEmitOnError false",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts packages/auth/src"
  },
  "dependencies": {
    "@culebra/db": "*",
    "@culebra/domain": "*",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "pdfkit": "^0.19.1",
    "stripe": "^22.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.9.2"
  }
}
