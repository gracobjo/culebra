generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleName {
  ADMIN
  VENDOR
  CONSUMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum VendorStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  DISABLED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

enum CommissionRuleType {
  PERCENTAGE
  FIXED
  CATEGORY
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum VendorOrderStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PAYMENT_PENDING
  PAYMENT_AUTHORIZED
  PAYMENT_PAID
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  PAYMENT_PARTIALLY_REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SIGN
  LOGIN
  LOGOUT
  STATUS_CHANGE
}

enum NotificationType {
  ORDER
  PAYMENT
  CONTRACT
  PRODUCT
  SYSTEM
}

// ---------------------------------------------------------------------------
// Users & RBAC
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  phone        String?
  status       UserStatus @default(ACTIVE)
  mfaEnabled   Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles               UserRole[]
  vendor              Vendor?
  addresses           Address[]
  carts               Cart[]
  orders              Order[]
  favorites           Favorite[]
  reviews             Review[]
  notifications       Notification[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  contractAcceptances ContractAcceptance[]
}

model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  createdAt DateTime @default(now())

  users UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ---------------------------------------------------------------------------
// Vendors
// ---------------------------------------------------------------------------

model Vendor {
  id          String       @id @default(cuid())
  userId      String       @unique
  tradeName   String
  legalName   String?
  taxId       String?
  slug        String       @unique
  description String?      @db.Text
  history     String?      @db.Text
  street      String?
  city        String?
  province    String?
  postalCode  String?
  country     String       @default("ES")
  phone       String?
  email       String?
  website     String?
  socialLinks Json?
  logoUrl     String?
  status      VendorStatus @default(DRAFT)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  documents       VendorDocument[]
  contracts       VendorContract[]
  commissionRules CommissionRule[]
  products        Product[]
  inventory       Inventory[]
  orderItems      OrderItem[]
  vendorOrders    VendorOrder[]
  payouts         Payout[]
  reviews         Review[]
}

model VendorDocument {
  id           String         @id @default(cuid())
  vendorId     String
  type         String
  title        String
  fileUrl      String
  status       DocumentStatus @default(PENDING)
  reviewNotes  String?        @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
}

// ---------------------------------------------------------------------------
// Contracts (versioned, never overwrite)
// ---------------------------------------------------------------------------

model VendorContract {
  id        String         @id @default(cuid())
  vendorId  String
  status    ContractStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  vendor   Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  versions VendorContractVersion[]

  @@index([vendorId, status])
}

model VendorContractVersion {
  id                String         @id @default(cuid())
  contractId        String
  versionNumber     Int
  startDate         DateTime?
  endDate           DateTime?
  status            ContractStatus @default(DRAFT)
  documentUrl       String?
  commissionPercent Decimal?       @db.Decimal(5, 2)
  conditions        String?        @db.Text
  observations      String?        @db.Text
  createdAt         DateTime       @default(now())

  contract    VendorContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  acceptances ContractAcceptance[]

  @@unique([contractId, versionNumber])
}

model ContractAcceptance {
  id                String   @id @default(cuid())
  contractVersionId String
  userId            String
  ipAddress         String?
  documentHash      String?
  acceptedAt        DateTime @default(now())

  contractVersion VendorContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id])

  @@index([contractVersionId])
}

// ---------------------------------------------------------------------------
// Commissions (versioned, never retroactive)
// ---------------------------------------------------------------------------

model CommissionRule {
  id            String             @id @default(cuid())
  vendorId      String
  versionNumber Int
  ruleType      CommissionRuleType @default(PERCENTAGE)
  percentage    Decimal?           @db.Decimal(5, 2)
  fixedAmount   Decimal?           @db.Decimal(12, 2)
  categoryId    String?
  validFrom     DateTime           @default(now())
  validTo       DateTime?
  notes         String?            @db.Text
  createdAt     DateTime           @default(now())

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([vendorId, versionNumber])
  @@index([vendorId, validFrom])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  slug        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent              Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children            Category[]       @relation("CategoryHierarchy")
  products            Product[]        @relation("ProductCategory")
  subcategoryProducts Product[]        @relation("ProductSubcategory")
  commissionRules     CommissionRule[]
}

model Product {
  id                 String        @id @default(cuid())
  vendorId           String
  categoryId         String
  subcategoryId      String?
  name               String
  slug               String
  shortDescription   String?       @db.Text
  longDescription    String?       @db.Text
  basePrice          Decimal       @db.Decimal(12, 2)
  previousPrice      Decimal?      @db.Decimal(12, 2)
  vatRate            Decimal       @default(10) @db.Decimal(5, 2)
  unit               String?
  weight             Decimal?      @db.Decimal(10, 3)
  sku                String?
  characteristics    Json?
  ingredients        String?       @db.Text
  allergens          String?       @db.Text
  conservation       String?       @db.Text
  origin             String?
  producerInfo       String?       @db.Text
  shippingConditions String?       @db.Text
  prepTimeDays       Int?
  status             ProductStatus @default(DRAFT)
  rejectionReason    String?       @db.Text
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  vendor      Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category    Category         @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategory Category?        @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  inventory   Inventory[]
  cartItems   CartItem[]
  favorites   Favorite[]
  reviews     Review[]

  @@unique([vendorId, slug])
  @@index([status])
  @@index([categoryId])
  @@index([vendorId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  label         String
  sku           String?
  unit          String?
  weight        Decimal? @db.Decimal(10, 3)
  price         Decimal  @db.Decimal(12, 2)
  previousPrice Decimal? @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory[]
  cartItems CartItem[]

  @@unique([productId, label])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Inventory {
  id        String   @id @default(cuid())
  vendorId  String
  productId String
  variantId String?
  stock     Int      @default(0)
  updatedAt DateTime @updatedAt

  vendor  Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId])
  @@index([vendorId])
}

// ---------------------------------------------------------------------------
// Cart (supports guest via sessionId)
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?    @unique
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id                String  @id @default(cuid())
  cartId            String
  productId         String
  variantId         String?
  vendorId          String
  quantity          Int     @default(1)
  unitPriceSnapshot Decimal @db.Decimal(12, 2)
  vatRateSnapshot   Decimal @db.Decimal(5, 2)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
}

// ---------------------------------------------------------------------------
// Orders (unified for consumer, split internally by vendor)
// ---------------------------------------------------------------------------

model Order {
  id                      String      @id @default(cuid())
  orderNumber             String      @unique
  userId                  String?
  customerEmail           String
  customerPhone           String?
  customerFirstName       String?
  customerLastName        String?
  shippingAddressSnapshot Json
  billingAddressSnapshot  Json
  status                  OrderStatus @default(PENDING)
  currency                String      @default("EUR")
  subtotalGross           Decimal     @db.Decimal(12, 2)
  marketplaceCommission   Decimal     @default(0) @db.Decimal(12, 2)
  otherFees               Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal                Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount             Decimal     @db.Decimal(12, 2)
  netToVendorsTotal       Decimal     @default(0) @db.Decimal(12, 2)
  notes                   String?     @db.Text
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  items        OrderItem[]
  vendorOrders VendorOrder[]
  payment      Payment?
  refunds      Refund[]

  @@index([userId])
  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  vendorId         String
  productId        String
  variantId        String?
  productName      String
  variantLabel     String?
  sku              String?
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2)
  vatRate          Decimal @db.Decimal(5, 2)
  subtotalGross    Decimal @db.Decimal(12, 2)
  commissionRate   Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  vendorNetAmount  Decimal @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor      Vendor            @relation(fields: [vendorId], references: [id])
  vendorOrder VendorOrderItem?

  @@index([orderId])
  @@index([vendorId])
}

model VendorOrder {
  id                    String            @id @default(cuid())
  orderId               String
  vendorId              String
  status                VendorOrderStatus @default(PENDING)
  subtotalGross         Decimal           @db.Decimal(12, 2)
  marketplaceCommission Decimal           @default(0) @db.Decimal(12, 2)
  otherFees             Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal              Decimal           @default(0) @db.Decimal(12, 2)
  vendorNetAmount       Decimal           @db.Decimal(12, 2)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor   Vendor            @relation(fields: [vendorId], references: [id])
  items    VendorOrderItem[]
  shipment Shipment?
  payout   Payout?

  @@unique([orderId, vendorId])
  @@index([vendorId, status])
}

model VendorOrderItem {
  id            String @id @default(cuid())
  vendorOrderId String
  orderItemId   String @unique

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Payments & Payouts
// ---------------------------------------------------------------------------

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  provider              String        @default("stripe")
  status                PaymentStatus @default(PAYMENT_PENDING)
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("EUR")
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payouts Payout[]
  refunds Refund[]
}

model Refund {
  id             String   @id @default(cuid())
  orderId        String
  paymentId      String
  amount         Decimal  @db.Decimal(12, 2)
  reason         String?  @db.Text
  stripeRefundId String?
  createdAt      DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Payout {
  id                    String       @id @default(cuid())
  vendorId              String
  vendorOrderId         String       @unique
  paymentId             String?
  status                PayoutStatus @default(PENDING)
  amountGross           Decimal      @db.Decimal(12, 2)
  commissionMarketplace Decimal      @db.Decimal(12, 2)
  otherFees             Decimal      @default(0) @db.Decimal(12, 2)
  amountNetToVendor     Decimal      @db.Decimal(12, 2)
  stripeTransferId      String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id])

  @@index([vendorId, status])
}

// ---------------------------------------------------------------------------
// Shipments (vendor-managed, future carrier integration)
// ---------------------------------------------------------------------------

model Shipment {
  id              String         @id @default(cuid())
  vendorOrderId   String         @unique
  carrier         String?
  trackingNumber  String?
  status          ShipmentStatus @default(PENDING)
  shippedAt       DateTime?
  estimatedAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([trackingNumber])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Addresses, Reviews, Favorites, Notifications
// ---------------------------------------------------------------------------

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(BOTH)
  firstName  String
  lastName   String
  street     String
  city       String
  province   String
  postalCode String
  country    String      @default("ES")
  phone      String?
  taxId      String?
  company    String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  vendorId  String?
  orderId   String?
  rating    Int
  title     String?
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  vendor  Vendor?  @relation(fields: [vendorId], references: [id])

  @@index([productId])
  @@index([vendorId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  actorIp     String?
  entityType  String
  entityId    String
  action      AuditAction
  fieldName   String?
  oldValue    String?     @db.Text
  newValue    String?     @db.Text
  metadata    Json?
  createdAt   DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}
