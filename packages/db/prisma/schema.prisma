generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleName {
  ADMIN
  VENDOR
  CONSUMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum VendorStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  DISABLED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

enum CommissionRuleType {
  PERCENTAGE
  FIXED
  CATEGORY
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum VendorOrderStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum SlaStatus {
  PENDING      // Sin notificar aún
  NOTIFIED     // Productor notificado, esperando recepción en tienda
  AT_RISK      // Quedan menos de 4h para el deadline y no hay recepción
  FULFILLED    // Recibido en tienda antes del deadline
  BREACHED     // Deadline superado sin recepción
}

enum PaymentStatus {
  PAYMENT_PENDING
  PAYMENT_AUTHORIZED
  PAYMENT_PAID
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  PAYMENT_PARTIALLY_REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

/// Liquidación anual de rappel por volumen (Opción A retroactiva).
enum RappelSettlementStatus {
  PENDING
  PAID
  CANCELLED
}

enum RappelPaymentMethod {
  TRANSFER
  PAYOUT_OFFSET
}

enum ShipmentStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SIGN
  LOGIN
  LOGOUT
  STATUS_CHANGE
}

enum StoredDocumentKind {
  ORDER_CUSTOMER
  ORDER_VENDOR
  PRODUCT_CHANGE
}

enum NotificationType {
  ORDER
  PAYMENT
  CONTRACT
  PRODUCT
  SYSTEM
}

enum AccommodationStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum AccommodationBookingChannel {
  BOOKING
  WEBSITE
  WHATSAPP
  PHONE
  EMAIL
  OTHER
}

enum TourismPackStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

// ---------------------------------------------------------------------------
// Users & RBAC
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  phone        String?
  status       UserStatus @default(ACTIVE)
  mfaEnabled   Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles               UserRole[]
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  vendor              Vendor?
  addresses           Address[]
  carts               Cart[]
  orders              Order[]
  favorites           Favorite[]
  reviews             Review[]
  notifications       Notification[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  storedDocuments     StoredDocument[]     @relation("StoredDocumentOwner")
  contractAcceptances ContractAcceptance[]
  couponRedemptions   CouponRedemption[]
}

model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  createdAt DateTime @default(now())

  users UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Vendors
// ---------------------------------------------------------------------------

enum VendorPayoutMethod {
  STRIPE_CONNECT
  PAYPAL
}

model Vendor {
  id          String       @id @default(cuid())
  userId      String       @unique
  tradeName   String
  legalName   String?
  taxId       String?
  slug        String       @unique
  description String?      @db.Text
  history     String?      @db.Text
  street      String?
  city        String?
  province    String?
  postalCode  String?
  country     String       @default("ES")
  phone       String?
  email       String?
  website     String?
  socialLinks Json?
  logoUrl     String?
  stripeAccountId      String?  @unique
  stripeChargesEnabled Boolean  @default(false)
  payoutMethod         VendorPayoutMethod @default(STRIPE_CONNECT)
  paypalEmail          String?
  status      VendorStatus @default(DRAFT)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  documents       VendorDocument[]
  contracts       VendorContract[]
  commissionRules CommissionRule[]
  products        Product[]
  pilotRecord     PilotProducer?
  inventory       Inventory[]
  orderItems      OrderItem[]
  vendorOrders       VendorOrder[]
  payouts            Payout[]
  reviews            Review[]
  rappelSettlements  RappelSettlement[]
}

model VendorDocument {
  id           String         @id @default(cuid())
  vendorId     String
  type         String
  title        String
  fileUrl      String
  status       DocumentStatus @default(PENDING)
  reviewNotes  String?        @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
}

// ---------------------------------------------------------------------------
// Contracts (versioned, never overwrite)
// ---------------------------------------------------------------------------

model VendorContract {
  id        String         @id @default(cuid())
  vendorId  String
  status    ContractStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  vendor   Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  versions VendorContractVersion[]

  @@index([vendorId, status])
}

model VendorContractVersion {
  id                String         @id @default(cuid())
  contractId        String
  versionNumber     Int
  startDate         DateTime?
  endDate           DateTime?
  status            ContractStatus @default(DRAFT)
  documentUrl       String?
  commissionPercent Decimal?       @db.Decimal(5, 2)
  conditions        String?        @db.Text
  observations      String?        @db.Text
  createdAt         DateTime       @default(now())

  contract    VendorContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  acceptances ContractAcceptance[]

  @@unique([contractId, versionNumber])
}

model ContractAcceptance {
  id                String   @id @default(cuid())
  contractVersionId String
  userId            String
  ipAddress         String?
  documentHash      String?
  acceptedAt        DateTime @default(now())

  contractVersion VendorContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id])

  @@index([contractVersionId])
}

// ---------------------------------------------------------------------------
// Commissions (versioned, never retroactive)
// ---------------------------------------------------------------------------

model CommissionRule {
  id            String             @id @default(cuid())
  vendorId      String
  versionNumber Int
  ruleType      CommissionRuleType @default(PERCENTAGE)
  percentage    Decimal?           @db.Decimal(5, 2)
  fixedAmount   Decimal?           @db.Decimal(12, 2)
  categoryId    String?
  validFrom     DateTime           @default(now())
  validTo       DateTime?
  notes         String?            @db.Text
  createdAt     DateTime           @default(now())

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([vendorId, versionNumber])
  @@index([vendorId, validFrom])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  slug        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent              Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children            Category[]       @relation("CategoryHierarchy")
  products            Product[]        @relation("ProductCategory")
  subcategoryProducts Product[]        @relation("ProductSubcategory")
  commissionRules     CommissionRule[]
}

model Product {
  id                 String        @id @default(cuid())
  vendorId           String
  categoryId         String
  subcategoryId      String?
  name               String
  slug               String
  shortDescription   String?       @db.Text
  longDescription    String?       @db.Text
  basePrice          Decimal       @db.Decimal(12, 2)
  previousPrice      Decimal?      @db.Decimal(12, 2)
  vatRate            Decimal       @default(10) @db.Decimal(5, 2)
  unit               String?
  weight             Decimal?      @db.Decimal(10, 3)
  sku                String?
  characteristics    Json?
  ingredients        String?       @db.Text
  allergens          String?       @db.Text
  conservation       String?       @db.Text
  origin             String?
  producerInfo       String?       @db.Text
  shippingConditions String?       @db.Text
  prepTimeDays       Int?
  status             ProductStatus @default(DRAFT)
  rejectionReason    String?       @db.Text
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  vendor      Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category    Category         @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategory Category?        @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  inventory   Inventory[]
  cartItems   CartItem[]
  favorites   Favorite[]
  reviews     Review[]
  packItems   TourismPackItem[]
  accommodations AccommodationProduct[]

  @@unique([vendorId, slug])
  @@index([status])
  @@index([categoryId])
  @@index([vendorId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  label         String
  sku           String?
  unit          String?
  weight        Decimal? @db.Decimal(10, 3)
  price         Decimal  @db.Decimal(12, 2)
  previousPrice Decimal? @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory[]
  cartItems CartItem[]

  @@unique([productId, label])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Inventory {
  id        String   @id @default(cuid())
  vendorId  String
  productId String
  variantId String?
  stock     Int      @default(0)
  updatedAt DateTime @updatedAt

  vendor  Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId])
  @@index([vendorId])
}

// ---------------------------------------------------------------------------
// Cart (supports guest via sessionId)
// ---------------------------------------------------------------------------

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  sessionId  String?    @unique
  status     CartStatus @default(ACTIVE)
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id                String  @id @default(cuid())
  cartId            String
  productId         String
  variantId         String?
  vendorId          String
  quantity          Int     @default(1)
  unitPriceSnapshot Decimal @db.Decimal(12, 2)
  vatRateSnapshot   Decimal @db.Decimal(5, 2)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
}

// ---------------------------------------------------------------------------
// Orders (unified for consumer, split internally by vendor)
// ---------------------------------------------------------------------------

model Order {
  id                      String      @id @default(cuid())
  orderNumber             String      @unique
  userId                  String?
  customerEmail           String
  customerPhone           String?
  customerFirstName       String?
  customerLastName        String?
  shippingAddressSnapshot Json
  billingAddressSnapshot  Json
  status                  OrderStatus @default(PENDING)
  currency                String      @default("EUR")
  subtotalGross           Decimal     @db.Decimal(12, 2)
  marketplaceCommission   Decimal     @default(0) @db.Decimal(12, 2)
  otherFees               Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal                Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount             Decimal     @db.Decimal(12, 2)
  netToVendorsTotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount          Decimal     @default(0) @db.Decimal(12, 2)
  shippingAmount          Decimal     @default(0) @db.Decimal(12, 2)
  couponCode              String?
  affiliateCode           String?
  notes                   String?     @db.Text
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user              User?              @relation(fields: [userId], references: [id])
  items             OrderItem[]
  vendorOrders      VendorOrder[]
  payment           Payment?
  refunds           Refund[]
  couponRedemptions CouponRedemption[]

  @@index([userId])
  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
  @@index([affiliateCode])
  @@index([couponCode])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  vendorId         String
  productId        String
  variantId        String?
  productName      String
  variantLabel     String?
  sku              String?
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2)
  vatRate          Decimal @db.Decimal(5, 2)
  subtotalGross    Decimal @db.Decimal(12, 2)
  commissionRate   Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  vendorNetAmount  Decimal @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor      Vendor            @relation(fields: [vendorId], references: [id])
  vendorOrder VendorOrderItem?

  @@index([orderId])
  @@index([vendorId])
}

model VendorOrder {
  id                    String            @id @default(cuid())
  orderId               String
  vendorId              String
  status                VendorOrderStatus @default(PENDING)
  subtotalGross         Decimal           @db.Decimal(12, 2)
  marketplaceCommission Decimal           @default(0) @db.Decimal(12, 2)
  otherFees             Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal              Decimal           @default(0) @db.Decimal(12, 2)
  vendorNetAmount       Decimal           @db.Decimal(12, 2)
  // SLA timestamps para control de cumplimiento logístico
  slaNotifiedAt         DateTime?         // Hora en que el sistema notificó al productor
  slaDeadlineAt         DateTime?         // Límite máximo de entrega en tienda (cut-off + 24h)
  slaReceivedAt         DateTime?         // Hora en que el socio escanea el paquete en trastienda
  slaStatus             SlaStatus         @default(PENDING)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor   Vendor            @relation(fields: [vendorId], references: [id])
  items    VendorOrderItem[]
  shipment Shipment?
  payout   Payout?

  @@unique([orderId, vendorId])
  @@index([vendorId, status])
}

model VendorOrderItem {
  id            String @id @default(cuid())
  vendorOrderId String
  orderItemId   String @unique

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Payments & Payouts
// ---------------------------------------------------------------------------

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  provider              String        @default("stripe")
  status                PaymentStatus @default(PAYMENT_PENDING)
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("EUR")
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payouts Payout[]
  refunds Refund[]
}

model Refund {
  id             String   @id @default(cuid())
  orderId        String
  paymentId      String
  amount         Decimal  @db.Decimal(12, 2)
  reason         String?  @db.Text
  stripeRefundId String?
  createdAt      DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Payout {
  id                    String       @id @default(cuid())
  vendorId              String
  vendorOrderId         String       @unique
  paymentId             String?
  status                PayoutStatus @default(PENDING)
  amountGross           Decimal      @db.Decimal(12, 2)
  commissionMarketplace Decimal      @db.Decimal(12, 2)
  otherFees             Decimal      @default(0) @db.Decimal(12, 2)
  amountNetToVendor     Decimal      @db.Decimal(12, 2)
  stripeTransferId      String?
  paypalPayoutBatchId   String?
  /// Fecha en que se levanta la retención del derecho de desistimiento (14 días desde el pago)
  releasesAt            DateTime?
  /// true mientras el pago está retenido por el periodo de desistimiento
  heldForWithdrawal     Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id])

  @@index([vendorId, status])
}

/// Abono anual de rappel (cierre de año natural). Snapshot congelado al cerrar.
model RappelSettlement {
  id                String                 @id @default(cuid())
  vendorId          String
  /// Año natural liquidado (ej. 2025)
  year              Int
  tierId            String                 // bronze | silver | gold
  tierName          String
  rebatePct         Decimal                @db.Decimal(5, 2)
  annualRevenue     Decimal                @db.Decimal(12, 2)
  commissionCharged Decimal                @db.Decimal(12, 2)
  rebateAmount      Decimal                @db.Decimal(12, 2)
  status            RappelSettlementStatus @default(PENDING)
  /// Plazo contractual: 60 días tras el 31 de diciembre
  dueAt             DateTime
  paidAt            DateTime?
  paymentMethod     RappelPaymentMethod?
  notes             String?                @db.Text
  closedByUserId    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, year])
  @@index([year, status])
  @@index([status, dueAt])
}

// ---------------------------------------------------------------------------
// Shipments (vendor-managed, future carrier integration)
// ---------------------------------------------------------------------------

model Shipment {
  id              String         @id @default(cuid())
  vendorOrderId   String         @unique
  carrier         String?
  trackingNumber  String?
  status          ShipmentStatus @default(PENDING)
  shippedAt       DateTime?
  estimatedAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([trackingNumber])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Addresses, Reviews, Favorites, Notifications
// ---------------------------------------------------------------------------

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(BOTH)
  firstName  String
  lastName   String
  street     String
  city       String
  province   String
  postalCode String
  country    String      @default("ES")
  phone      String?
  taxId      String?
  company    String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  vendorId  String?
  orderId   String?
  rating    Int
  title     String?
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  vendor  Vendor?  @relation(fields: [vendorId], references: [id])

  @@index([productId])
  @@index([vendorId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ---------------------------------------------------------------------------
// Pilot Producer Programme (Grupo Piloto Mes 2-6)
// ---------------------------------------------------------------------------

enum PilotStatus {
  IDENTIFIED    // Identificado, pendiente de visita
  CONTACTED     // Visita realizada, propuesta entregada
  NEGOTIATING   // En negociación (condiciones fundador)
  ONBOARDED     // Onboarding completado, cuenta Stripe activa
  BETA_TESTING  // Participando en Fase Beta (Mes 5)
  ACTIVE        // Lanzamiento público — productor activo
  DECLINED      // No interesado / descartado
}

enum PilotTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

model PilotProducer {
  id              String      @id @default(cuid())
  category        String      // Nombre de categoría (snapshot; catálogo en PilotCategory)
  producerName    String      // Nombre comercial del artesano
  contactPerson   String?
  phone           String?
  email           String?
  location        String?     // Municipio
  status          PilotStatus @default(IDENTIFIED)
  commissionPct   Decimal     @default(10) @db.Decimal(5, 2)   // 10% año fundador
  founderDiscount Boolean     @default(true)
  notes           String?     @db.Text
  vendorId        String?     @unique   // enlace una vez que se onboardea
  visitDate       DateTime?
  onboardedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tasks  PilotTask[]
  vendor Vendor?     @relation(fields: [vendorId], references: [id])
  valueProposition PilotValueProposition?

  @@index([status])
}

/// Catálogo de categorías del programa piloto (CRUD admin, persistente).
model PilotCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?  // emoji opcional para la UI
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model PilotTask {
  id              String          @id @default(cuid())
  pilotProducerId String
  phase           Int             // 1=Selección, 2=Captación, 3=Beta
  title           String
  description     String?         @db.Text
  status          PilotTaskStatus @default(PENDING)
  assignedTo      String?         // nombre del socio responsable
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  producer PilotProducer @relation(fields: [pilotProducerId], references: [id], onDelete: Cascade)

  @@index([pilotProducerId, phase])
}

/// Ficha de propuesta de valor (Fase 1) — documento comercial por productor piloto.
model PilotValueProposition {
  id              String   @id @default(cuid())
  pilotProducerId String   @unique
  /// Titular / eslogan de la propuesta
  headline        String?
  /// Situación del productor y por qué encaja
  context         String?  @db.Text
  /// Beneficios para el productor (texto, uno por línea)
  benefits        String?  @db.Text
  /// Condiciones fundadores (comisión, retención, etc.)
  offerTerms      String?  @db.Text
  /// Productos / surtido sugerido para el arranque
  productMix      String?  @db.Text
  /// Próximos pasos de la visita
  nextSteps       String?  @db.Text
  /// Notas internas del comercial
  internalNotes   String?  @db.Text
  preparedBy      String?
  status          String   @default("DRAFT") // DRAFT | READY
  preparedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  producer PilotProducer @relation(fields: [pilotProducerId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Stored documents (retention for orders / product changes)
// ---------------------------------------------------------------------------

model StoredDocument {
  id             String             @id @default(cuid())
  kind           StoredDocumentKind
  ownerUserId    String?
  entityType     String
  entityId       String
  title          String
  snapshot       Json
  retentionUntil DateTime
  createdAt      DateTime           @default(now())

  owner User? @relation("StoredDocumentOwner", fields: [ownerUserId], references: [id])

  @@index([ownerUserId, kind, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([retentionUntil])
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  actorIp     String?
  entityType  String
  entityId    String
  action      AuditAction
  fieldName   String?
  oldValue    String?     @db.Text
  newValue    String?     @db.Text
  metadata    Json?
  createdAt   DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Turismo territorial (fases 2–3): alojamientos, packs, cupones, afiliación
// ---------------------------------------------------------------------------

model Accommodation {
  id              String                      @id @default(cuid())
  name            String
  slug            String                      @unique
  shortDescription String?                    @db.Text
  longDescription String?                     @db.Text
  kind            String                      @default("CASA_RURAL") // CASA_RURAL | HOSTAL | HOTEL | APARTAMENTO
  city            String?
  municipality    String?
  province        String                      @default("Zamora")
  address         String?
  phone           String?
  email           String?
  whatsapp        String?
  websiteUrl      String?
  bookingUrl      String?
  bookingChannel  AccommodationBookingChannel @default(WEBSITE)
  imageUrl        String?
  capacity        Int?
  status          AccommodationStatus         @default(DRAFT)
  sortOrder       Int                         @default(0)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  products      AccommodationProduct[]
  packs         TourismPack[]
  affiliateCodes AffiliateCode[]
  lodgingRelation LodgingPartnerRelation?

  @@index([status, sortOrder])
  @@index([city])
}

/// CRM de colaboración con hosteleros / alojamientos rurales (canal showroom).
enum LodgingRelationStatus {
  PROSPECT
  CONTACTED
  MATERIAL_PLACED
  ACTIVE
  PAUSED
  ENDED
}

enum LodgingCollabModality {
  PRESENCE_RECOMMEND
  WELCOME_BASKET
  COMMISSION_SALE
  NIGHT_PACK
}

enum LodgingWelcomeMode {
  SPECIAL_PRICE
  CONSIGNMENT
}

enum LodgingRelationEventType {
  CONTACT
  MATERIAL
  REFERRAL
  BASKET
  THANK_YOU_GIFT
  COMMISSION
  AGREEMENT
  NOTE
  STATUS_CHANGE
}

model LodgingPartnerRelation {
  id                      String                 @id @default(cuid())
  accommodationId         String?                @unique
  name                    String
  contactPerson           String?
  phone                   String?
  whatsapp                String?
  email                   String?
  city                    String?
  distanceMinutes         Int?
  rating                  Decimal?               @db.Decimal(3, 2)
  status                  LodgingRelationStatus  @default(PROSPECT)
  /// Nivel operativo 1–5 (máxima intensidad activa)
  collabLevel             Int                    @default(1)
  primaryModality         LodgingCollabModality?
  /// Modalidades aceptadas (JSON string[] de LodgingCollabModality)
  modalitiesJson          String                 @default("[]")
  welcomeMode             LodgingWelcomeMode?
  welcomeSpecialPrice     Decimal?               @db.Decimal(12, 2)
  /// Cada N clientes referidos → detalle (p. ej. cesta Escapada)
  referralThreshold       Int                    @default(8)
  referredClientsCount    Int                    @default(0)
  thankYouGiftsSent       Int                    @default(0)
  basketsViaCount         Int                    @default(0)
  showroomVisitsAttributed Int                   @default(0)
  onlineOrdersAttributed  Int                    @default(0)
  materialPlacedAt        DateTime?
  agreementAcceptedAt     DateTime?
  agreementNotes          String?                @db.Text
  nextFollowUpAt          DateTime?
  notes                   String?                @db.Text
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  accommodation Accommodation?          @relation(fields: [accommodationId], references: [id], onDelete: SetNull)
  events        LodgingRelationEvent[]

  @@index([status, updatedAt])
  @@index([city])
  @@index([nextFollowUpAt])
}

model LodgingRelationEvent {
  id          String                   @id @default(cuid())
  relationId  String
  type        LodgingRelationEventType
  quantity    Int?
  amount      Decimal?                 @db.Decimal(12, 2)
  note        String?                  @db.Text
  occurredAt  DateTime                 @default(now())
  createdAt   DateTime                 @default(now())

  relation LodgingPartnerRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId, occurredAt])
  @@index([type])
}

/// Datos de contacto Sabores para fichas de colaboración (singleton id=1).
model SiteLodgingOfferContacts {
  id              Int      @id @default(1)
  whatsapp        String?
  phone           String?
  email           String?
  websiteUrl      String?
  contactPerson   String?
  showroomAddress String?  @default("Villardeciervos (Zamora)")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AccommodationProduct {
  accommodationId String
  productId       String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([accommodationId, productId])
}

model TourismPack {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  shortDescription String?           @db.Text
  longDescription  String?           @db.Text
  accommodationId  String?
  nightsHint       String?           // e.g. "2 noches (reserva externa)"
  imageUrl         String?
  status           TourismPackStatus @default(DRAFT)
  sortOrder        Int               @default(0)
  couponId         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  accommodation Accommodation?    @relation(fields: [accommodationId], references: [id], onDelete: SetNull)
  coupon        Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         TourismPackItem[]

  @@index([status, sortOrder])
}

model TourismPackItem {
  id        String @id @default(cuid())
  packId    String
  productId String
  quantity  Int    @default(1)
  sortOrder Int    @default(0)

  pack    TourismPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([packId, productId])
}

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  description     String?            @db.Text
  discountType    CouponDiscountType
  discountValue   Decimal            @db.Decimal(12, 2)
  minOrderAmount  Decimal?           @db.Decimal(12, 2)
  maxRedemptions  Int?
  redemptionCount Int                @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  packs       TourismPack[]
  redemptions CouponRedemption[]

  @@index([isActive, code])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String
  userId    String?
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@unique([couponId, orderId])
  @@index([orderId])
}

model AffiliateCode {
  id              String   @id @default(cuid())
  code            String   @unique
  label           String
  accommodationId String?
  isActive        Boolean  @default(true)
  clickCount      Int      @default(0)
  orderCount      Int      @default(0)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accommodation Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: SetNull)

  @@index([isActive, code])
}

/// Configuración global del sitio para enlaces sociales (admin /contacto / pie).
/// Se usa como singleton: el `id` queda fijo en `1`.
model SiteSocialLinks {
  id           Int      @id @default(1)
  facebookUrl  String?
  instagramUrl String?
  whatsappUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Bloques (divs) del hub «Tienda de la comarca» en inicio / tienda.
model HomeHubTile {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  href        String
  description String   @db.Text
  imageUrl    String
  altText     String
  hintText    String
  tone        String   @default("agro") // agro | territory
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Estadísticas diarias del showroom físico (base para ML / export CSV).
model ShowroomDailyStat {
  id                  String   @id @default(cuid())
  date                DateTime @unique @db.Date
  open                Boolean  @default(true)
  visits              Int      @default(0)
  purchases           Int      @default(0)
  gmv                 Decimal  @default(0) @db.Decimal(12, 2)
  avgTicketBase       Decimal  @default(0) @db.Decimal(12, 2)
  /// Porcentaje 0–100
  impulseAttachPct    Decimal  @default(0) @db.Decimal(5, 2)
  impulseAvgEur       Decimal  @default(0) @db.Decimal(12, 2)
  quickBuyPct         Decimal  @default(0) @db.Decimal(5, 2)
  quickBuyTicket      Decimal  @default(0) @db.Decimal(12, 2)
  mielU               Int      @default(0)
  loncheadoU          Int      @default(0)
  mermeladaU          Int      @default(0)
  quesoU              Int      @default(0)
  toteU               Int      @default(0)
  picosU              Int      @default(0)
  vinoU               Int      @default(0)
  minicataU           Int      @default(0)
  toteStock           Int      @default(0)
  onlineOrders        Int      @default(0)
  onlineOrdersAttr    Int      @default(0)
  contacts            Int      @default(0)
  referredVisits      Int      @default(0)
  basketsViaLodging   Int      @default(0)
  partnersActive      Int      @default(0)
  promotion           Boolean  @default(false)
  holidayOrEvent      Boolean  @default(false)
  marketSegment       String?
  distributionChannel String?
  notes               String?  @db.Text
  sourceSyncedAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([date])
}
